---
import { getCollection } from "astro:content";

const alcohols = await getCollection('alcohols');

const { activeSlug } = Astro.props;

alcohols.sort((a, b) => {
  const nameA = a.data.name.toLocaleLowerCase();
  const nameB = b.data.name.toLocaleLowerCase();

  if (nameA === nameB) {
    return 0;
  }

  return nameA > nameB ? 1 : -1;
});
---
<ul class="flex flex-wrap gap-3">
  {alcohols.map(
    (alcohol) => {
    const classNames = ["bg-base", "border", "border-base-light", "flex", "align-items-center", "p-2", "rounded-xl", "text-lg md:text-2xl", "hover:border-secondary", "hover:shadow-xs", "hover:shadow-secondary"].concat(
    alcohol.data.slug === activeSlug ? ["border-secondary", "text-secondary"] : ["text-white"]
      );

      return (
        <li class={classNames.concat('hover:scale-105').join(' ')}>
          <a href={`/alcools/${alcohol.data.slug}`}>{alcohol.data.name}</a>
        </li>
      )
    })}
</ul>
